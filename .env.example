# API settings
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# Database settings
DATABASE_URI=postgresql://user:password@localhost:5432/career_platform
# For MongoDB, use: mongodb://user:password@localhost:27017/career_platform

# CORS settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://localhost:3000"]

# Email settings
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=Career Platform

# URLs
SERVER_HOST=localhost:8000
FRONTEND_URL=http://localhost:3000

# First superuser
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-please

# Verification settings
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24